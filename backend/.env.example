# ==============================================================================
# Contract Clause Risk-Flagging and Redline-Suggestion Agent
# Environment Configuration
# ==============================================================================

# LLM & Embedding Provider (e.g. gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
ENABLE_LLM_SEGMENT_REFINEMENT=false
ENABLE_PLAYBOOK_AUTO_INGEST=false
DEFAULT_TOP_K=3
CONFIDENCE_THRESHOLD=0.7
CONCURRENCY_LIMIT=5
MAX_LLM_RETRIES=2

# Vector Store and Database Storage Paths
CHROMA_PATH=./data/chroma
DB_PATH=./data/app.db
CHECKPOINT_DB_PATH=./data/checkpoints.db
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ENABLE_CHECKPOINTER=true
